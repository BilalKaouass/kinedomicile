---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Demande envoyée | Kinedomicile.be"
  description="Votre demande de rendez-vous a été envoyée."
>

  <section class="section">
    <div class="container appointment-content">

      <span class="eyebrow">
        Demande envoyée
      </span>

      <h1>
        Merci pour votre demande.
      </h1>

      <p>
        Votre demande a été transmise.
        L'équipe vous recontactera pour
        discuter des disponibilités.
      </p>

      <a href="/" class="btn-primary">
        Retour à l'accueil
      </a>

    </div>
  </section>

</BaseLayout>