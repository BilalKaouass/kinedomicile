
---
import { site } from "../data/site";

const phone = site.phone;
const whatsappNumber = phone.replace(/\D/g, "");

const message = encodeURIComponent(
  "Bonjour, je souhaiterais obtenir un rendez-vous de kinésithérapie à domicile dans le Grand Charleroi. Pouvez-vous me renseigner sur vos disponibilités ? Merci."
);

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=${message}`;
---

<div class="floating-contact" aria-label="Contact rapide">

  <!-- WhatsApp -->
  <a
    href={whatsappUrl}
    class="floating-contact__button floating-contact__whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter Kinedomicile sur WhatsApp"
    title="Écrivez-nous sur WhatsApp"
  >
   
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0C5.46 0 .1 5.35.1 11.94c0 2.1.55 4.16 1.6 5.97L0 24l6.25-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.59 0 11.94-5.35 11.94-11.94a11.87 11.87 0 0 0-3.48-8.42ZM12.06 21.82a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.62-.23-.37a9.9 9.9 0 0 1-1.52-5.27c0-5.46 4.44-9.9 9.9-9.9a9.84 9.84 0 0 1 7 2.9 9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.88-9.92 9.88Zm5.43-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.1 4.5.71.31 1.27.49 1.7.63.71.22 1.35.19 1.86.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
</svg>

    <span class="floating-contact__label">WhatsApp</span>
  </a>

  <!-- Téléphone -->
  <a
    href={`tel:${phone}`}
    class="floating-contact__button floating-contact__phone"
    aria-label={`Appeler Kinedomicile au ${site.phoneDisplay}`}
    title="Appeler Kinedomicile"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="23"
      height="23"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.19 18a19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 1.09 3.18 2 2 0 0 1 3.08 1h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.68 2.79a2 2 0 0 1-.45 2.11L7.04 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.68A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span class="floating-contact__label">Appeler</span>
  </a>

</div>
