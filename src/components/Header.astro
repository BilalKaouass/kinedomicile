
---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="container header-inner">

    <a href="/" class="brand" aria-label="Kinedomicile.be - Accueil">
      <span class="brand-mark" aria-hidden="true">
        <svg
          viewBox="0 0 48 48"
          width="42"
          height="42"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="24"
            cy="24"
            r="21"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M24 9V39M14 19H34M17 29H31"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
          <circle cx="24" cy="12" r="3" fill="currentColor" />
        </svg>
      </span>

      <span class="brand-text">
        <strong>Kinedomicile</strong>
        <span>Kinésithérapie à domicile</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      <a href="/#equipe">Notre équipe</a>
      <a href="/#soins">Nos soins</a>
      <a href="/#zones">Zones d'intervention</a>
      <a href="/contact/">Contact</a>
    </nav>

    <a
      href={`tel:${site.phone}`}
      class="header-cta"
      aria-label={`Appeler le ${site.phoneDisplay}`}
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18
          2A19.79 19.79 0 0 1 11.19
          18a19.5 19.5 0 0 1-6-6A19.79
          19.79 0 0 1 2.09 3.18
          2 2 0 0 1 4.08 1h3a2 2 0
          0 1 2 1.72c.12.96.36
          1.9.72 2.8a2 2 0 0
          1-.45 2.11L8.09 8.91a16
          16 0 0 0 6 6l1.27-1.27a2
          2 0 0 1 2.11-.45c.9.36
          1.84.6 2.8.72A2 2 0 0 1
          22 16.92Z"
        />
      </svg>

      <span>Nous appeler</span>
    </a>

  </div>
</header>
